# OTTOMAN FC CONNECT - Environment Configuration

# Application
NEXTAUTH_SECRET=ottoman-fc-connect-dev-secret-change-in-production
NEXTAUTH_URL=http://localhost:3000

# Database (PostgreSQL or SQLite)
# Set USE_SQLITE=true to use SQLite (no server required, works immediately)
# Set USE_SQLITE=false to use PostgreSQL
USE_SQLITE=true

# Database (PostgreSQL)
# NOTE: Port 5432 is occupied by a locked postgres instance that cannot be
# authenticated or terminated on this machine. A separate postgres instance
# running on port 5434 with trust auth is intended for local development.
DATABASE_URL=postgresql://postgres@127.0.0.1:5434/ottomanfc

DB_HOST=127.0.0.1
DB_PORT=5434
DB_USER=postgres
DB_PASSWORD=
DB_NAME=ottomanfc

# File storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# JWT
JWT_SECRET=ottoman-fc-connect-jwt-secret-change-in-production
JWT_EXPIRES_IN=7d

# Club defaults
CLUB_NAME=OTTOMAN FC
PLATFORM_NAME=OTTOMAN FC CONNECT
DEFAULT_CURRENCY=UGX
TIMEZONE=Africa/Kampala
