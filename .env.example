# =============================================================================
# OTTOMAN FC CONNECT - Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in your actual values.
# Never commit .env.local to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. DATABASE (Neon PostgreSQL)
# -----------------------------------------------------------------------------
# Get this from your Neon dashboard → Project → Connection string
# Format: postgresql://<user>:<password>@<host>:5432/<dbname>?sslmode=require
DATABASE_URL="postgresql://ottoman_user:your_password@ep-xxx.us-east-1.aws.neon.tech/ottoman_fc?sslmode=require"

# -----------------------------------------------------------------------------
# 2. AUTHENTICATION (JWT)
# -----------------------------------------------------------------------------
# Generate a secure secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-32-character-or-longer-random-secret-here"
JWT_EXPIRES_IN="7d"

# -----------------------------------------------------------------------------
# 3. APP URL
# -----------------------------------------------------------------------------
# Used for password reset links and email verification links
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# 4. EMAIL SERVICE (SMTP) — for verification & notifications
# -----------------------------------------------------------------------------
# Option A: SMTP (any provider — Gmail, Outlook, Mailgun, SendGrid, etc.)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"          # Set "true" for port 465, "false" for 587
SMTP_USER="your-smtp-username"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM="noreply@ottomanfc.com"
SMTP_FROM_NAME="OTTOMAN FC Connect"

# Option B: Resend API (resend.com) — simpler alternative to SMTP
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxx"
# RESEND_FROM="noreply@ottomanfc.com"

# -----------------------------------------------------------------------------
# 5. FILE UPLOADS
# -----------------------------------------------------------------------------
# Local storage path (used by KYC upload and player registration)
UPLOAD_DIR="./uploads"

# -----------------------------------------------------------------------------
# 6. RATE LIMITING
# -----------------------------------------------------------------------------
LOGIN_RATE_LIMIT_WINDOW_MINUTES="15"
LOGIN_RATE_LIMIT_MAX_ATTEMPTS="5"

# =============================================================================
# END OF CONFIGURATION
# =============================================================================
