# OTTOMAN FC CONNECT - Environment Configuration
# Copy this file to .env.local and adjust values for your environment.

# Application
NEXTAUTH_SECRET=ottoman-fc-connect-dev-secret-change-in-production
NEXTAUTH_URL=http://localhost:3000

# Database (PostgreSQL)
# Configure DATABASE_URL to point to your PostgreSQL instance.
# Example: postgresql://ottomanfc:password@localhost:5432/ottomanfc
DATABASE_URL=postgresql://ottomanfc:ottomanfc_dev@localhost:5432/ottomanfc

# Database host/port (alternative individual config)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=ottomanfc
DB_PASSWORD=ottomanfc_dev
DB_NAME=ottomanfc

# File storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# JWT
JWT_SECRET=ottoman-fc-connect-jwt-secret-change-in-production
JWT_EXPIRES_IN=7d

# Club defaults
CLUB_NAME=OTTOMAN FC
PLATFORM_NAME=OTTOMAN FC CONNECT
DEFAULT_CURRENCY=UGX
TIMEZONE=Africa/Kampala
